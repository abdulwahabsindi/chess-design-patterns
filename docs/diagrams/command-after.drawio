et="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c80" value="" style="endArrow=block;endFill=0;endSize=14;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c58" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c81" value="kingMove, rookMove" style="endArrow=open;endSize=10;startArrow=diamondThin;startFill=1;startSize=14;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c58" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c82" value="2" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c81"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c83" value="piece, captured, promotion" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;fontSize=10;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c45" target="c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c84" value="0..3" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c83"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c85" value="Command pattern roles&lt;br&gt;• Command: the Command interface&lt;br&gt;• Concrete Commands: MoveCommand, CastlingCommand&lt;br&gt;&amp;nbsp;&amp;nbsp;(CastlingCommand is a macro: it runs two MoveCommands)&lt;br&gt;• Invoker: MoveHistory (runs commands, keeps undo and redo stacks)&lt;br&gt;• Client: GamePanel (createMove builds the command)&lt;br&gt;• Receiver: the board (piecesBoard) and its Chessman objects&lt;br&gt;• Trigger: GameFrame's Edit menu (Cmd/Ctrl+Z, Cmd/Ctrl+Shift+Z)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="520" height="150" as="geometry"/></mxCell><mxCell id="c86" value="Turn rules stay in each mode:&lt;br&gt;• Hot: undo 1 move, flip whiteMove&lt;br&gt;• AI: undo 2 moves (yours + AI reply), only when enabled&lt;br&gt;• LAN: message only (boards would differ)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="480" height="90" as="geometry"/></mxCell><mxCell id="c87" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c86" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>