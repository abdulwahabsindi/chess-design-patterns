llapsible=1;marginBottom=0;html=1;" vertex="1" parent="1"><mxGeometry x="1185" y="340" width="440" height="78" as="geometry"/></mxCell><mxCell id="f44" value="- cache: Map&amp;lt;String, PieceSprite&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontStyle=4;" vertex="1" parent="f43"><mxGeometry x="0" y="26" width="440" height="22" as="geometry"/></mxCell><mxCell id="f45" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;html=1;" vertex="1" parent="f43"><mxGeometry x="0" y="48" width="440" height="8" as="geometry"/></mxCell><mxCell id="f46" value="+ get(type: ChessmanType, color: SideColor): PieceSprite" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontStyle=4;" vertex="1" parent="f43"><mxGeometry x="0" y="56" width="440" height="22" as="geometry"/></mxCell><mxCell id="f47" value="sprite" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="f37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f48" value="*" style="edgeLabel;resizable=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f47"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="f49" value="1" style="edgeLabel;resizable=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f47"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="f50" value="«call» draw(g, x, y, size)" style="endArrow=open;endSize=10;dashed=1;html=1;fontStyle=2;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f33" target="f37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f51" value="" style="endArrow=open;endSize=10;startArrow=diamondThin;startFill=0;startSize=16;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f43" target="f37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f52" value="0..12" style="edgeLabel;resizable=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f51"><mxGeometry x="0.6" relative="1" as="geometry"><mxPoint x="24" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="f53" value="Each constructor fetches its shared sprite, e.g. Pawn:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;sprite = PieceSprites.get(ChessmanType.PAWN, color);&lt;/font&gt;&lt;br&gt;copy() uses super.clone(), so a copy keeps the same sprite." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="420" height="70" as="geometry"/></mxCell><mxCell id="f54" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="f53" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f55" value="paintComponent passes the square (extrinsic state):&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;piecesBoard[i][j].sprite.draw(g, i * SQUARE_SIZE, j * SQUARE_SIZE, SQUARE_SIZE);&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="20" width="220" height="104" as="geometry"/></mxCell><mxCell id="f56" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="f55" target="f33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f57" value="get() returns the cached sprite, or creates it on the first request. The cache is keyed by file name (e.g. PW.png) and serves every game, so at most 12 sprites exist. A sprite reads its PNG the first time it is drawn." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="300" width="220" height="140" as="geometry"/></mxCell><mxCell id="f58" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="f57" target="f43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f59" value="&lt;b&gt;Flyweight roles&lt;/b&gt;&lt;br&gt;Flyweight: PieceSprite. Intrinsic state: the image. Extrinsic state: x, y, size.&lt;br&gt;Flyweight factory: PieceSprites&lt;br&gt;Clients: GamePanel (draws), Pawn, Rook, Knight, Bishop, Queen, King (hold a sprite)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="700" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>