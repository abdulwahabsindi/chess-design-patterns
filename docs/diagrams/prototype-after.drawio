ew&quot;&gt;clone.pos = new Position(pos.x, pos.y);&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;return clone;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="420" height="86" as="geometry"/></mxCell><mxCell id="p44" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="p43" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p45" value="The subclasses inherit copy(). super.clone() copies every field, including Pawn.startPosition, so a copy keeps whether the piece has moved." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="560" height="50" as="geometry"/></mxCell><mxCell id="p46" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="p45" target="p12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p47" value="minMax: &lt;font face=&quot;Courier New&quot;&gt;Chessman[][] tempBoard = copyBoard(board);&lt;/font&gt;&lt;br&gt;copyBoard calls copy() on every piece and never names a concrete class." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1185" y="252" width="620" height="50" as="geometry"/></mxCell><mxCell id="p48" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="p47" target="p37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p49" value="&lt;b&gt;Prototype roles&lt;/b&gt;&lt;br&gt;Prototype: Chessman&lt;br&gt;Concrete prototypes: Pawn, Rook, Knight, Bishop, Queen, King&lt;br&gt;Client: AI" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1185" y="530" width="620" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>