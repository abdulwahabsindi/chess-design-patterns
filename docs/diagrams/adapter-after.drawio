"480" height="96" as="geometry"/></mxCell><mxCell id="c72" value="The adapter translates in both directions:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;sendMove(from, to)&lt;/font&gt;&lt;br&gt;→ &lt;font face=&quot;Courier New&quot;&gt;out.writeObject(from);&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp; &lt;font face=&quot;Courier New&quot;&gt;out.writeObject(to);&lt;/font&gt;&lt;br&gt;&lt;br&gt;two &lt;font face=&quot;Courier New&quot;&gt;in.readObject()&lt;/font&gt; calls on a background thread&lt;br&gt;→ &lt;font face=&quot;Courier New&quot;&gt;listener.onMoveReceived(from, to)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1560" y="20" width="340" height="150" as="geometry"/></mxCell><mxCell id="c73" value="" style="endArrow=none;dashed=1;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.15;entryDx=0;entryDy=0;" parent="1" edge="1" source="c72" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="The panel has no Socket or stream code left. It only knows OpponentConnection and MoveListener." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="40" y="530" width="340" height="50" as="geometry"/></mxCell><mxCell id="c75" value="" style="endArrow=none;dashed=1;html=1;rounded=0;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="c74" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>