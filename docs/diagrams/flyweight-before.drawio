ry x="0" y="78" width="560" height="22" as="geometry"/></mxCell><mxCell id="f44" value="+ loadImages(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="f39"><mxGeometry x="0" y="100" width="560" height="22" as="geometry"/></mxCell><mxCell id="f45" value="+ paintComponent(g: Graphics): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="f39"><mxGeometry x="0" y="122" width="560" height="22" as="geometry"/></mxCell><mxCell id="f46" value="«read» imgSrc" style="endArrow=open;endSize=10;dashed=1;html=1;fontStyle=2;labelBackgroundColor=#ffffff;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f39" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f47" value="Each piece class picks a slot in GamePanel's imgTable, e.g. Pawn:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;if (this.color == SideColor.WHITE) {&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;    imgSrc = 5;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;} else imgSrc = 11;&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="420" height="86" as="geometry"/></mxCell><mxCell id="f48" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="f47" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f49" value="loadImages() runs in the constructor, so every new game reads the 12 PNGs again:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;imgTable[5] = ImageIO.read(getClass().getResource(source + &quot;PW.png&quot;));&lt;/font&gt;&lt;br&gt;paintComponent: &lt;font face=&quot;Courier New&quot;&gt;g.drawImage(imgTable[piecesBoard[i][j].imgSrc], ...);&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1185" y="300" width="560" height="86" as="geometry"/></mxCell><mxCell id="f50" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="f49" target="f39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f51" value="Nothing ties 5 in Pawn to slot 5 in loadImages() except convention. Renumber either side and the wrong picture is drawn, with no error." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="560" height="50" as="geometry"/></mxCell><mxCell id="f52" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="f51" target="f9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>