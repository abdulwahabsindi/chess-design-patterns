e»&lt;br&gt;&lt;b&gt;OpponentConnection&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;" parent="1" vertex="1"><mxGeometry x="1180" y="830" width="340" height="92" as="geometry"/></mxCell><mxCell id="c49" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;html=1;" parent="c48" vertex="1"><mxGeometry x="0" y="40" width="340" height="8" as="geometry"/></mxCell><mxCell id="c50" value="+ sendMove(from: Position, to: Position): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" parent="c48" vertex="1"><mxGeometry x="0" y="48" width="340" height="22" as="geometry"/></mxCell><mxCell id="c51" value="+ close(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" parent="c48" vertex="1"><mxGeometry x="0" y="70" width="340" height="22" as="geometry"/></mxCell><mxCell id="c52" value="connection" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c23" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="&lt;b&gt;Template Method (the existing design)&lt;/b&gt;&lt;br&gt;checkChessmanMove() (GamePanel.java, lines 234–250) is the template:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;moveChessman(newPosition, _selected.pos);&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;opponentTurn();&lt;/font&gt;&lt;br&gt;opponentTurn() is the one abstract step. Each subclass fills it in, so the kind of opponent is fixed by which subclass Menu creates." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1240" y="20" width="600" height="110" as="geometry"/></mxCell><mxCell id="c54" value="" style="endArrow=none;dashed=1;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="c53" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="The opponent is not only in opponentTurn():&lt;br&gt;- the colour and connection dialogs run in the constructors&lt;br&gt;- GamePanelLAN overrides moveChessman to send every local move, and calls super.moveChessman for received moves so they are not sent back" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1620" y="420" width="260" height="150" as="geometry"/></mxCell><mxCell id="c56" value="" style="endArrow=none;dashed=1;html=1;rounded=0;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" parent="1" edge="1" source="c55" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="Menu.java, lines 50–79: one button per subclass&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;new GameFrame(new GamePanelHot());&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;new GameFrame(new GamePanelLAN());&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;new GameFrame(new GamePanelAI());&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="60" y="110" width="420" height="90" as="g