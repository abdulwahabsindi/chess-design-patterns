 x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c50" value="Smell: moveChessman() overwrites state and keeps no record of it.&lt;br&gt;• piecesBoard[new] = piece: a captured piece is lost (L298)&lt;br&gt;• a pawn on the last row is replaced by a new Queen (L294)&lt;br&gt;• Pawn.startPosition and notMoved are set to false (L290, L301)&lt;br&gt;• castling() moves the Rook and clears its notMoved (L250-277)&lt;br&gt;_lastMove keeps only 2 squares, for the highlight.&lt;br&gt;So a move can't be undone." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="560" height="150" as="geometry"/></mxCell><mxCell id="c51" value="" style="endArrow=none;dashed=1;html=1;exitX=0;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="575"/><mxPoint x="20" y="202"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>