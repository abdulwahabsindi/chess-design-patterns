erticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontStyle=4;" vertex="1" parent="p40"><mxGeometry x="0" y="56" width="620" height="22" as="geometry"/></mxCell><mxCell id="p44" value="«call» copy(chess)" style="endArrow=open;endSize=10;dashed=1;html=1;fontStyle=2;labelBackgroundColor=#ffffff;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p40" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p45" value="Each subclass overrides copy(other) by calling its own constructor:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;return new Pawn(color, pos.x, pos.y);&lt;/font&gt;&lt;br&gt;The parameter other is never used." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="420" height="76" as="geometry"/></mxCell><mxCell id="p46" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="p45" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p47" value="The constructors set notMoved = true (King, Rook) and startPosition = true (Pawn), so a copy forgets that the piece has already moved." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="560" height="50" as="geometry"/></mxCell><mxCell id="p48" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="p47" target="p9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p49" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="p47" target="p14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p50" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="p47" target="p30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p51" value="minMax builds the copy inline:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Arrays.stream(board).map(arr -&amp;gt; Arrays.stream(arr)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;  .map(chess -&amp;gt; chess == null ? null : chess.copy(chess))&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;  .toArray(Chessman[]::new)).toArray(Chessman[][]::new);&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1185" y="230" width="620" height="86" as="geometry"/></mxCell><mxCell id="p52" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="p51" target="p40"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>